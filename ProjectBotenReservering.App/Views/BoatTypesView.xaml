<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProjectBotenReservering.App.ViewModels"
             xmlns:models="clr-namespace:ProjectBotenReservering.Core.Models;assembly=ProjectBotenReservering.Core"
             x:Class="ProjectBotenReservering.App.Views.BoatTypesView"
             x:DataType="vm:BoatTypesViewModel"
             BackgroundColor="White">
    
    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *">

            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20">
                
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Start">
                    <Label Text="Reservatie" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="Black" />
                    <Label Text="Selecteer een boot" 
                           FontSize="16" 
                           TextColor="Gray" 
                           Margin="0,5,0,0"/>
                </VerticalStackLayout>

                <!-- Filter thingies-->
                <Grid Grid.Column="1" 
                      RowDefinitions="Auto, Auto, Auto" 
                      ColumnDefinitions="Auto, Auto" 
                      ColumnSpacing="10"
                      RowSpacing="5">

                    <Label Grid.Row="0" Grid.Column="0" 
                           Text="Minimale gewicht" 
                           FontSize="12" 
                           TextColor="Black" />

                    <Border Grid.Row="1" Grid.Column="0" 
                            Stroke="Gray" 
                            StrokeShape="RoundRectangle 5"
                            HeightRequest="35"
                            WidthRequest="60"
                            VerticalOptions="Start">
                        <Entry Placeholder="" 
                               Keyboard="Numeric" 
                               TextColor="Black"
                               VerticalTextAlignment="Center"
                               Text="{Binding HasMinWeightFilter, Mode=TwoWay}"/>
                    </Border>

                    <!-- SearchBar -->
                    <Border Grid.Row="1" Grid.Column="1" 
                            Stroke="Gray"
                            StrokeShape="RoundRectangle 20"
                            HeightRequest="35"
                            VerticalOptions="Start">
                        <SearchBar Placeholder="Search" 
                                   WidthRequest="200" 
                                   VerticalTextAlignment="Center"
                                   TextColor="Black"
                                   PlaceholderColor="Gray"
                                   Text="{Binding HasStringInNameFilter, Mode=TwoWay}"/>
                    </Border>

                    <!-- Checkbox for steering wheel -->
                    <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                           Spacing="5" 
                                           VerticalOptions="Start">
                        <CheckBox Color="Black"
                                  IsChecked="{Binding HasSteeringWheelFilter, Mode=TwoWay}"/>
                        <Label Text="stuur" 
                               VerticalOptions="Center" 
                               TextColor="Black"
                               FontSize="14"/>
                    </HorizontalStackLayout>
                </Grid>
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding BoatTypeItems}" SelectionMode="None" Margin="10">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BoatTypeUiItem">

                        <Frame BorderColor="Gray" CornerRadius="10" Padding="0" IsClippedToBounds="True">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BoatTypesViewModel}}, Path=SelectBoatTypeCommand}"
                                                      CommandParameter="{Binding }"/>
                            </Frame.GestureRecognizers>

                            <Grid RowDefinitions="120, Auto">

                                <Image Grid.Row="0"
                                       Source="{Binding ImagePath}"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />

                                <Grid Grid.Row="1"
                                      Padding="10"
                                      BackgroundColor="White">

                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Center"
                                           TextColor="Black" />

                                    <Label Text="{Binding SeatAmmount}"
                                           FontSize="12"
                                           TextColor="Gray"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>