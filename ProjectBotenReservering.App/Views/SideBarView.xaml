<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProjectBotenReservering.App.ViewModels"
             xmlns:models="clr-namespace:ProjectBotenReservering.Core.Models;assembly=ProjectBotenReservering.Core"
             xmlns:helpers="clr-namespace:ProjectBotenReservering.App.Helpers"
             x:Class="ProjectBotenReservering.App.Views.SideBarView"
             x:DataType="vm:SideBarViewModel">

    <ContentPage.Resources>
        <helpers:TabItemToViewHelper x:Key="TabConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <CollectionView Grid.Column="0"
                        Background="LightGray"
                        ItemsSource="{Binding Tabs}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TabItem">
                    <VerticalStackLayout Padding="0, 15, 0, 0" HorizontalOptions="Center">
                        <Button Clicked="OnTabButtonClicked"
                            ImageSource="{Binding ImageName}"
                                WidthRequest="50"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ContentView Grid.Column="1" 
                     Content="{Binding SelectedTab, Converter={StaticResource TabConverter}}" />
    </Grid>
</ContentPage>