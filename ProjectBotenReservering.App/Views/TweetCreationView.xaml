<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProjectBotenReservering.App.ViewModels"
             x:Class="ProjectBotenReservering.App.Views.TweetCreationView"
             x:DataType="vm:TweetCreationViewModel"
             BackgroundColor="White">
             
    <Grid RowDefinitions="*, Auto" BackgroundColor="White">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="30">

                <!-- Header -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Wedstrijden" 
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="Black" />
                    
                    <Label Text="Wedstrijd promoten" 
                           FontSize="20"
                           TextColor="#505050" />
                </VerticalStackLayout>

                <!-- Welcome Message -->
                <Border Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="15"
                        BackgroundColor="#F9F9F9">
                    <Grid ColumnDefinitions="50, *" ColumnSpacing="10">
                        <Label Text="🤖" 
                               FontSize="30" 
                               VerticalOptions="Start"
                               HorizontalOptions="Center"/>
                        
                        <Label Grid.Column="1" x:Name="WelcomeLabel" 
                               Text="{Binding PageWelcomeMessage}"
                               FontSize="14"
                               TextColor="#333333"
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </Border>

                <!-- Tweet Editor -->
                <Border Stroke="#CCCCCC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        HeightRequest="200"
                        Shadow="{Shadow Brush=Black, Offset='2,2', Opacity=0.1, Radius=5}">
                    
                    <Grid RowDefinitions="*, Auto">
                        
                        <Editor x:Name="TweetEditor"
                                Grid.Row="0"
                                Placeholder="Tweet wordt gegenereerd... Even geduld a.u.b."
                                Text="{Binding TweetContent}"
                                TextColor="#333333"
                                FontSize="20"
                                AutoSize="TextChanges"
                                VerticalOptions="Fill"
                                BackgroundColor="Transparent"
                                IsEnabled="{Binding IsTweetContentEditableByUser}"
                                Margin="15,15,40,5"/> 
                        
                        <Label Text="✏️"
                               Grid.Row="0"
                               HorizontalOptions="End"
                               VerticalOptions="Start"
                               FontSize="20"
                               Margin="15"
                               Opacity="0.5"/>

                        <Label Text="{Binding ContentLength, StringFormat='{0}/280'}"
                               Grid.Row="1"
                               HorizontalOptions="End"
                               VerticalOptions="End"
                               FontSize="12"
                               TextColor="Gray"
                               Margin="10,0,15,10"/>
                    </Grid>
                </Border>

                <!-- File Picker -->
                <Grid ColumnDefinitions="Auto, *, Auto" 
                      ColumnSpacing="15" 
                      VerticalOptions="Center">
                    
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Foto toevoegen" TextColor="Black" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="(optioneel)" TextColor="Gray" FontSize="12"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="1" 
                            Stroke="#CCCCCC" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 5"
                            BackgroundColor="#F5F5F5"
                            HeightRequest="40"
                            VerticalOptions="Center">
                        <Entry IsReadOnly="True" 
                               Placeholder="Geen bestand gekozen"
                               Text="{Binding SelectedFileName}"
                               TextColor="Black"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               Margin="10,0"
                               FontSize="14"/>
                    </Border>

                    <Button Grid.Column="2"
                            Text="Bladeren..."
                            Command="{Binding PickFileCommand}"
                            CornerRadius="5"
                            HeightRequest="35"
                            Padding="15,0"
                            FontSize="14"
                            VerticalOptions="Center"/>
                </Grid>
                
                <!-- Image Preview -->
                <Border IsVisible="{Binding IsImagePreviewVisible}"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#FAFAFA"
                        Padding="10"
                        HorizontalOptions="Center">
                    <Image Source="{Binding SelectedImagePreview}"
                           HeightRequest="200"
                           Aspect="AspectFit"
                           BackgroundColor="Transparent"/>
                </Border>

                <!-- Spacer -->
                <BoxView HeightRequest="20" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Bar -->
        <Border Grid.Row="1" 
                Stroke="#E0E0E0" 
                StrokeThickness="1" 
                BackgroundColor="White" 
                Padding="20,15" 
                VerticalOptions="End">
            <Grid ColumnDefinitions="Auto, *">
                <Button Grid.Column="1"
                        Text="Publiceren"
                        Command="{Binding PublishTweetCommand}"
                        HorizontalOptions="End"
                        CornerRadius="5"
                        HeightRequest="50"
                        WidthRequest="200"
                        FontSize="18"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>