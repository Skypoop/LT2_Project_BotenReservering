<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProjectBotenReservering.App.ViewModels"
             xmlns:models="clr-namespace:ProjectBotenReservering.Core.Models;assembly=ProjectBotenReservering.Core"
             x:Class="ProjectBotenReservering.App.Views.BoatTypeSelectionCompetitionView"
             x:DataType="vm:BoatTypeSelectionCompetitionViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto, Auto, *" Padding="10" RowSpacing="10">

            <!-- Back Button Row -->
            <Button Grid.Row="0"
                    Text="Terug" 
                    Command="{Binding BackCommand}" 
                    BackgroundColor="LightGray" 
                    TextColor="Black" 
                    FontSize="14"
                    HeightRequest="36" 
                    WidthRequest="80"
                    CornerRadius="5"
                    HorizontalOptions="Start"
                    Margin="10,0,0,0"/>

            <!-- Title and Filters Row -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Padding="10,0">

                <!-- Page Title -->
                <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                    <Label Text="Reservering" 
                           FontSize="24" 
                           FontAttributes="Bold"
                           TextColor="Black"/>
                    <Label Text="Selecteer een boot" 
                           FontSize="16" 
                           TextColor="Gray"/>
                </VerticalStackLayout>

                <!-- Filters Section -->
                <HorizontalStackLayout Grid.Column="2" Spacing="15" HorizontalOptions="End" VerticalOptions="Center">

                    <!-- Min Weight Filter -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Min. gewicht" 
                               FontSize="12" 
                               TextColor="Black"
                               VerticalOptions="Center"/>
                        <Border Stroke="Gray" 
                                StrokeShape="RoundRectangle 5" 
                                HeightRequest="40" 
                                WidthRequest="80">
                            <Entry Placeholder="0" 
                                   Keyboard="Numeric" 
                                   TextColor="Black" 
                                   VerticalTextAlignment="Center" 
                                   HorizontalTextAlignment="Center" 
                                   Text="{Binding MinWeightFilter, Mode=TwoWay}"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Steering Type Filter -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Stuurtype" 
                               FontSize="12" 
                               TextColor="Black"
                               VerticalOptions="Center"/>
                        <Border Stroke="Gray" 
                                StrokeShape="RoundRectangle 5" 
                                HeightRequest="40" 
                                WidthRequest="160">
                            <Picker ItemsSource="{Binding SteeringOptions}" 
                                    ItemDisplayBinding="{Binding DisplayName}" 
                                    SelectedItem="{Binding SelectedSteeringOption, Mode=TwoWay}" 
                                    TextColor="Black" 
                                    BackgroundColor="Transparent" 
                                    VerticalOptions="Center"
                                    Margin="5,0"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Search Bar -->
                    <Border Stroke="Gray" 
                            StrokeShape="RoundRectangle 20" 
                            HeightRequest="40"
                            WidthRequest="180">
                        <SearchBar Placeholder="Zoeken..." 
                                   VerticalTextAlignment="Center" 
                                   TextColor="Black" 
                                   PlaceholderColor="Gray" 
                                   Text="{Binding StringInNameFilter, Mode=TwoWay}"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- Boat Types List -->
            <CollectionView Grid.Row="2" 
                            ItemsSource="{Binding BoatTypeItems}" 
                            SelectionMode="None" 
                            Margin="10">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" 
                                     Span="2" 
                                     HorizontalItemSpacing="10" 
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BoatTypeUiItem">
                        <Border Stroke="Gray" 
                                StrokeShape="RoundRectangle 10" 
                                Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBoatTypeTapped" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="120, Auto">
                                <Image Grid.Row="0" 
                                       Source="{Binding ImagePath}" 
                                       Aspect="AspectFill" 
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Fill" />
                                <Grid Grid.Row="1" 
                                      Padding="10" 
                                      BackgroundColor="White">
                                    <Label Text="{Binding Name}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           HorizontalOptions="Start" 
                                           VerticalOptions="Center" 
                                           TextColor="Black" />
                                    <Label Text="{Binding Amount}" 
                                           FontSize="12" 
                                           TextColor="Gray" 
                                           HorizontalOptions="End" 
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>