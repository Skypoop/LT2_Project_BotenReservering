<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:plugin="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             x:Class="ProjectBotenReservering.App.Views.ReservationFormView"
             Title="boot"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Static Header -->
            <Label Text="Resevering"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#2196F3"
                   HorizontalOptions="Center"/>

            <!-- Calendar -->
            <Frame Padding="0" CornerRadius="10" BorderColor="Gray">
                <plugin:Calendar
                    SelectedDateColor="#2196F3"
                    TodayOutlineColor="Orange"
                    MonthLabelColor="Black"
                    YearLabelColor="Black"
                    DaysTitleColor="Gray" />
            </Frame>

            <!-- Time Inputs -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <!-- Start Time -->
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Start Time" TextColor="Gray"/>
                    <TimePicker Time="09:00:00" 
                                TextColor="Black"
                                BackgroundColor="#F0F0F0"/>
                </VerticalStackLayout>

                <!-- End Time -->
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="End Time" TextColor="Gray"/>
                    <TimePicker Time="12:00:00" 
                                TextColor="Black"
                                BackgroundColor="#F0F0F0"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Static Button -->
            <Button Text="Confirm Reservation"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="25"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>