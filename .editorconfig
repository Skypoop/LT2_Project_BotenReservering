root = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf

csharp_new_line_before_open_brace = all

csharp_space_after_comma = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_call_name_and_opening_parenthesis = false

dotnet_sort_system_directives_first = true

csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error

dotnet_naming_rule.interface_should_be_ipascal.severity = warning
dotnet_naming_rule.interface_should_be_ipascal.symbols = interface
dotnet_naming_rule.interface_should_be_ipascal.style = interface_style

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_style.interface_style.capitalization = pascal_case
dotnet_naming_style.interface_style.required_prefix = I

dotnet_naming_rule.types_should_be_pascal.severity = warning
dotnet_naming_rule.types_should_be_pascal.symbols = types
dotnet_naming_rule.types_should_be_pascal.style = pascal_case_style

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate

dotnet_naming_rule.members_should_be_pascal.severity = warning
dotnet_naming_rule.members_should_be_pascal.symbols = members
dotnet_naming_rule.members_should_be_pascal.style = pascal_case_style

dotnet_naming_symbols.members.applicable_kinds = method, property, namespace, event
dotnet_naming_symbols.members.applicable_accessibilities = *

dotnet_naming_rule.private_fields_should_be_underscore_camel.severity = warning
dotnet_naming_rule.private_fields_should_be_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel.style = underscore_camel_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = !const

dotnet_naming_style.underscore_camel_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_style.required_prefix = _

dotnet_naming_rule.constants_should_be_screaming_snake.severity = warning
dotnet_naming_rule.constants_should_be_screaming_snake.symbols = constant_fields
dotnet_naming_rule.constants_should_be_screaming_snake.style = screaming_snake_style

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_style.screaming_snake_style.capitalization = all_upper
dotnet_naming_style.screaming_snake_style.word_separator = _

dotnet_naming_rule.locals_should_be_camel.severity = warning
dotnet_naming_rule.locals_should_be_camel.symbols = locals_and_params
dotnet_naming_rule.locals_should_be_camel.style = camel_case_style

dotnet_naming_symbols.locals_and_params.applicable_kinds = parameter, local

dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.camel_case_style.capitalization = camel_case